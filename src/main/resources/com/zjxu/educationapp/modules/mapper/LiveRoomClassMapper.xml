<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjxu.educationapp.modules.mapper.LiveRoomClassMapper">

    <resultMap id="BaseResultMap" type="com.zjxu.educationapp.modules.entity.LiveRoomClassEntity">
            <id property="liveRoomClassId" column="live_room_class_id" />
            <result property="classId" column="class_id" />
            <result property="liveRoomId" column="live_room_id" />
    </resultMap>

    <sql id="Base_Column_List">
        live_room_class_id,class_id,live_room_id
    </sql>
    <!-- 批量插入直播间与班级的关联关系 -->
    <insert id="insertBatch">
        INSERT INTO live_room_class (class_id, live_room_id) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.classId}, #{item.liveRoomId})
        </foreach>
    </insert>
</mapper>
